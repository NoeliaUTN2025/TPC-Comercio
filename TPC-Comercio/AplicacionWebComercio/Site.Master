<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site.master.cs" Inherits="AplicacionWebComercio.SiteMaster" %>

<!DOCTYPE html>

<html lang="es">
<head runat="server">
<meta http-equiv="Content-Type" content="text/html; charset=utf-8"/>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%: Page.Title %> - Mi aplicación ASP.NET</title>

    <asp:PlaceHolder runat="server">
        <%: Scripts.Render("~/bundles/modernizr") %>
    </asp:PlaceHolder>

    <webopt:bundlereference runat="server" path="~/Content/css" />
    <link href="~/favicon.ico" rel="shortcut icon" type="image/x-icon" />

</head>
<body>
    <form runat="server">
        <asp:ScriptManager runat="server">
            <Scripts>
                <%--To learn more about bundling scripts in ScriptManager see https://go.microsoft.com/fwlink/?LinkID=301884 --%>
                <%--Framework Scripts--%>
                <asp:ScriptReference Name="MsAjaxBundle" />
                <asp:ScriptReference Name="jquery" />
                <asp:ScriptReference Name="WebForms.js" Assembly="System.Web" Path="~/Scripts/WebForms/WebForms.js" />
                <asp:ScriptReference Name="WebUIValidation.js" Assembly="System.Web" Path="~/Scripts/WebForms/WebUIValidation.js" />
                <asp:ScriptReference Name="MenuStandards.js" Assembly="System.Web" Path="~/Scripts/WebForms/MenuStandards.js" />
                <asp:ScriptReference Name="GridView.js" Assembly="System.Web" Path="~/Scripts/WebForms/GridView.js" />
                <asp:ScriptReference Name="DetailsView.js" Assembly="System.Web" Path="~/Scripts/WebForms/DetailsView.js" />
                <asp:ScriptReference Name="TreeView.js" Assembly="System.Web" Path="~/Scripts/WebForms/TreeView.js" />
                <asp:ScriptReference Name="WebParts.js" Assembly="System.Web" Path="~/Scripts/WebForms/WebParts.js" />
                <asp:ScriptReference Name="Focus.js" Assembly="System.Web" Path="~/Scripts/WebForms/Focus.js" />
                <asp:ScriptReference Name="WebFormsBundle" />
                <%--Site Scripts--%>
            </Scripts>
        </asp:ScriptManager>

        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-dark bg-dark">
            
            <div class="container">
                <a class="navbar-brand" runat="server" href="~/">Sistema de Gestion Comercial</a>
                <button type="button" class="navbar-toggler" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" title="Alternar navegación" aria-controls="navbarSupportedContent"
                    aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav me-auto">
                        <li runat="server" id="liInicio" class="nav-item">
                            <a class="nav-link" runat="server" href="~/Default.aspx">Inicio</a>
                        </li>

                        <%-- Inventario: Productos / Marcas / Categorías (Admin + Vendedor) --%>
                        <li runat="server" id="liGrupoInventario" class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown" aria-expanded="false">Inventario</a>
                            <ul class="dropdown-menu dropdown-menu-dark">
                                <li runat="server" id="liProductos">
                                    <a class="dropdown-item" href="Productos.aspx">Productos</a>
                                </li>
                                <li runat="server" id="liMarcas">
                                    <a class="dropdown-item" href="Marcas.aspx">Marcas</a>
                                </li>
                                <li runat="server" id="liCategorias">
                                    <a class="dropdown-item" href="Categorias.aspx">Categorías</a>
                                </li>
                            </ul>
                        </li>

                        <%-- Movimientos: Compras / Ventas / Trazabilidad (Admin + Vendedor) --%>
                        <li runat="server" id="liGrupoMovimientos" class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown" aria-expanded="false">Movimientos</a>
                            <ul class="dropdown-menu dropdown-menu-dark">
                                <li runat="server" id="liCompras">
                                    <a class="dropdown-item" href="Compras.aspx">Compras</a>
                                </li>
                                <li runat="server" id="liVentas">
                                    <a class="dropdown-item" href="Ventas.aspx">Ventas</a>
                                </li>
                                <li runat="server" id="liTrazabilidad">
                                    <a class="dropdown-item" href="TrazabilidadLote.aspx">Trazabilidad</a>
                                </li>
                                <li runat="server" id="liReportes">
                                    <a class="dropdown-item" href="ReportesDinamicos.aspx">Reportes</a>
                                </li>
                            </ul>
                        </li>

                        <%-- Personas: Clientes / Proveedores / Usuarios (Admin + Vendedor) --%>
                        <li runat="server" id="liGrupoPersonas" class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown" aria-expanded="false">Personas</a>
                            <ul class="dropdown-menu dropdown-menu-dark">
                                <li runat="server" id="liClientes">
                                    <a class="dropdown-item" href="Clientes.aspx">Clientes</a>
                                </li>
                                <li runat="server" id="liProveedores">
                                    <a class="dropdown-item" href="Proveedores.aspx">Proveedores</a>
                                </li>
                                <li runat="server" id="liUsuarios">
                                    <a class="dropdown-item" href="Usuarios.aspx">Usuarios</a>
                                </li>
                            </ul>
                        </li>

                        <%-- Cliente --%>
                        <li runat="server" id="liCatalogo" class="nav-item">
                            <a class="nav-link" runat="server" href="~/CatalogoProductos.aspx">Catálogo</a>
                        </li>
                        <li runat="server" id="liVentasCliente" class="nav-item">
                            <a class="nav-link" runat="server" href="~/Ventas.aspx">Mis Compras</a>
                        </li>

                        <%-- Proveedor --%>
                        <li runat="server" id="liMisCompras" class="nav-item">
                            <a class="nav-link" runat="server" href="~/MisCompras.aspx">Mis Propuestas</a>
                        </li>
                    </ul>
                    <ul class="navbar-nav ms-auto text-nowrap">
                        <li runat="server" id="liCambiarContrasena" class="nav-item"><a class="nav-link" runat="server" href="~/CambiarContrasena.aspx">Cambiar contraseña</a></li>
                        <li runat="server" id="liCrearCuenta"      class="nav-item"><a class="nav-link" runat="server" href="~/SeleccionTipoRegistro.aspx">Crear Cuenta</a></li>
                        <li runat="server" id="liLogin"            class="nav-item"><a class="nav-link" runat="server" href="~/Login.aspx">Login</a></li>
                        <li runat="server" id="liLogout"           class="nav-item"><a class="nav-link" runat="server" href="~/Logout.aspx">Logout</a></li>
                    </ul>
                </div>
            </div>
        </nav>
        <div class="container body-content">
            <asp:ContentPlaceHolder ID="MainContent" runat="server">
            </asp:ContentPlaceHolder>
            <hr />
            <footer>
                <p>&copy; <%: DateTime.Now.Year %> - Sistema de Gestion Comercial</p>
            </footer>
        </div>
    </form>
    <asp:PlaceHolder runat="server">
        <%: Scripts.Render("~/Scripts/bootstrap.bundle.js") %>
    </asp:PlaceHolder>
</body>
</html>
